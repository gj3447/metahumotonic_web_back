# Copy to .env and fill. All optional — unset values degrade gracefully.

# --- Neo4j (read-only KG) ---
# bhgman KG over Tailscale (see reference_neo4j_gds_vector_available)
MHB_NEO4J_URI=bolt://100.64.0.3:7687
# optional comma-separated backups tried when MHB_NEO4J_URI fails
MHB_NEO4J_FALLBACK_URIS=bolt://neo4j.data.svc.cluster.local:7687
MHB_NEO4J_USER=neo4j
MHB_NEO4J_PASSWORD=changeme
# set to true to query live KG; false (default) → snapshot fallback
MHB_NEO4J_LIVE=false

# --- KG Cypher proxy (external read/write split; opt-in) ---
# Both empty (default) → /api/kg/{read,write} return 503 (proxy disabled).
# Generate:
#   python3 -c "import secrets; print('mhk_read_'+secrets.token_urlsafe(32)); print('mhk_write_'+secrets.token_urlsafe(32))"
# Read key runs queries in a Neo4j READ tx (server rejects writes); the write
# key runs a WRITE tx and is also accepted on /api/kg/read.
MHB_KG_READ_KEY=
MHB_KG_WRITE_KEY=
MHB_KG_PROXY_MAX_ROWS=1000

# --- MongoDB (feedback intake) ---
# empty → in-memory store (no infra). On bhgman: mongodb://<host>:27017
MHB_MONGO_URI=
MHB_MONGO_DB=metahumotonic
MHB_MONGO_FEEDBACK_COLLECTION=web_feedback
# true in production: return 503 instead of acknowledging a volatile fallback
MHB_FEEDBACK_REQUIRE_DURABLE=false
# optional; empty disables the private GET /internal/feedback operator inbox
MHB_FEEDBACK_ADMIN_KEY=

# --- CORS ---
MHB_CORS_ORIGINS=https://metahumotonic.com,http://localhost:4321

# --- Feedback rate limit (per client IP) ---
MHB_FEEDBACK_MAX_PER_WINDOW=5
MHB_FEEDBACK_WINDOW_SECONDS=600

# --- Optional Cloudflare Turnstile ---
# Configure the matching site key in the frontend before setting this secret.
MHB_TURNSTILE_SECRET=
MHB_TURNSTILE_HOSTNAME=metahumotonic.com
MHB_TURNSTILE_ACTION=feedback_submit
MHB_TURNSTILE_FAIL_OPEN=false
