{
  "name": "metahumotonic-web-back-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect-TS functional port of metahumotonic-web-back. Runs ALONGSIDE the Python/FastAPI service — neither replaces the other.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestart": "npm run build",
    "start:tsx": "tsx src/main.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "effect": "^3.19.0",
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
