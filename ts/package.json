{
  "name": "metahumotonic-web-back-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Metahumotonic company backend: Effect services, program graph, native storage and MCP federation.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestart": "npm run build",
    "start:tsx": "tsx src/main.ts",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:persistence": "node scripts/test-persistence.mjs"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "effect": "^3.19.0",
    "mongodb": "6.21.0",
    "neo4j-driver": "^6.2.0",
    "pg": "8.23.0",
    "redis": "5.12.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "fast-check": "^4.9.0",
    "mongodb-memory-server-core": "10.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  }
}
